#compdef cmaal
# zsh completion for cmaal

_cmaal_hosts() {
    local -a hosts
    [[ -f ~/.ssh/config ]] && hosts=(${(f)"$(awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i !~ /[*?!]/) print $i }' ~/.ssh/config)"})
    print -l -- $hosts
}

_cmaal() {
    local -a cmds
    cmds=(
        '-S:install from repos, AUR or flatpak'
        '-Ss:search repos, AUR and flatpak'
        '-Si:package info'
        '-Syu:upgrade everything'
        '-Syyu:upgrade everything, force db refresh'
        '-Rns:remove package and unused deps'
        'install:install packages'
        'search:search everywhere'
        'remove:remove packages'
        'upgrade:upgrade everything'
        'ssh:ssh hosts and keys'
        'clean:remove orphans and trim caches'
        'mirrors:rank mirrors with reflector'
        'news:latest Arch news'
        'history:recent package changes'
        'updates:list pending updates'
        'why:why is a package installed'
        'files:files of a package'
        'provides:which package provides a command'
        'pkgbuild:show a package build script'
        'hold:keep packages at their version'
        'unhold:let held packages upgrade'
        'holds:list held packages'
        'orphans:unused dependencies'
        'kernel:running vs installed kernels'
        'disk:disk usage'
        'whatsnew:what changed in this version'
        'review:AUR safety check'
        'alerts:update notifications'
        'wifi:pick and join Wi-Fi'
        'bluetooth:pair and connect devices'
        'drivers:install missing drivers'
        'gaming:set up Steam and friends'
        'rescue:fix a system that will not boot'
        'backup:back up config files'
        'plugins:your own commands'
        'undo:revert the last pacman transaction'
        'downgrade:go back to an older version'
        'snapshot:snapper/timeshift snapshots'
        'fix:fix common pacman problems'
        'pkglist:export or import all packages'
        'services:manage systemd services'
        'logs:errors from the journal'
        'ports:listening ports'
        'ip:local and public IP'
        'theme:change kitty theme'
        'weather:weather forecast'
        'fetch:system info with the Arch logo'
        'owns:which package owns a command'
        'big:largest packages'
        'sys:system overview'
        'doctor:health check'
        'helper:show or install an AUR helper'
        'config:edit config'
        'self-update:update cmaal'
        'uninstall:remove cmaal'
        'help:show help'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' cmds
        return
    fi

    case $words[2] in
        -S|-Si|-Sy|install)
            compadd -- ${(f)"$(pacman -Slq 2>/dev/null)"} ;;
        -R*|-Q*|remove|downgrade|why|files|hold)
            compadd -- ${(f)"$(pacman -Qq 2>/dev/null)"} ;;
        ssh)
            if (( CURRENT == 3 )); then
                compadd -- -t ls add rm edit keygen keys copy test server help ${(f)"$(_cmaal_hosts)"}
            else
                case $words[3] in
                    server) compadd -- on off status ;;
                    rm|copy|test) compadd -- ${(f)"$(_cmaal_hosts)"} ;;
                esac
            fi
            ;;
        owns) _command_names ;;
        pkgbuild) compadd -- ${(f)"$(pacman -Slq 2>/dev/null)"} ;;
        unhold) compadd -- ${(f)"$(pacman-conf IgnorePkg 2>/dev/null)"} ;;
        orphans) compadd -- rm ;;
        whatsnew) compadd -- all ;;
        snapshot) compadd -- list create restore ;;
        pkglist) if (( CURRENT == 3 )); then compadd -- export import; else _files; fi ;;
        services)
            if (( CURRENT == 3 )); then
                compadd -- --user ${(f)"$(systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '{ sub(/\.service$/, "", $1); print $1 }')"}
            else
                compadd -- status start stop restart enable disable logs
            fi
            ;;
        logs) compadd -- prev -f ${(f)"$(systemctl list-unit-files --type=service --no-legend 2>/dev/null | awk '{ sub(/\.service$/, "", $1); print $1 }')"} ;;
        review) compadd -- ${(f)"$(pacman -Qqm 2>/dev/null)"} ;;
        alerts) compadd -- on off now status ;;
        wifi) compadd -- connect list status on off forget share ;;
        bluetooth) compadd -- status on off pair connect disconnect remove ;;
        backup) if (( CURRENT == 3 )); then compadd -- init add rm list log restore; else _files; fi ;;
        plugins) compadd -- list new edit rm dir ;;
        helper) compadd -- status install yay paru ;;
        config) compadd -- edit show path reset ;;
        self-update) compadd -- --force ;;
    esac
}

_cmaal "$@"
