#!/usr/bin/env bash
# cmaal legacy updater
#
# cmaal 0.1 and 0.2 were one single file, and `cmaal self-update` in those
# versions downloads exactly this path. Since 0.3.0 cmaal is a real pacman
# package (the code lives in bin/ and lib/), so this file only moves old
# installs over to the package, once. You never need to run it yourself.
#
# The line below must stay: the old self-update checks for it.
CMAAL_VERSION="0.3.0"

set -o pipefail

CMAAL_REPO="${CMAAL_REPO:-archlinux-dev/cmaal}"
CMAAL_BRANCH="${CMAAL_BRANCH:-main}"
RAW="https://raw.githubusercontent.com/${CMAAL_REPO}/${CMAAL_BRANCH}"

say() { printf '\e[1;34m::\e[0m %s\n' "$*"; }

say "cmaal v$CMAAL_VERSION is a proper pacman package now (pacman -Qi cmaal, man cmaal)."
say "Moving your install over. This happens once."

if ! { : </dev/tty; } 2>/dev/null; then
    say "Not running in a terminal, so not installing now. Run this in kitty:"
    printf '      curl -fsSL %s/install.sh | bash\n' "$RAW"
    exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
if ! curl -fsSL --max-time 30 "$RAW/install.sh" -o "$tmp"; then
    say "Could not download the installer. Try again later or run:"
    printf '      curl -fsSL %s/install.sh | bash\n' "$RAW"
    exit 1
fi

# The installer also deletes this file (it would hide /usr/bin/cmaal)
if bash "$tmp" </dev/tty && [[ -x /usr/bin/cmaal ]]; then
    hash -r 2>/dev/null
    say "Done! Continuing with your command using the new cmaal."
    (( $# )) && exec /usr/bin/cmaal "$@"
    exec /usr/bin/cmaal whatsnew
fi

say "The move did not finish. Nothing is lost, run the installer again with:"
printf '      curl -fsSL %s/install.sh | bash\n' "$RAW"
exit 1
