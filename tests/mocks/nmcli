#!/usr/bin/env bash
printf 'nmcli %s\n' "$*" >>"${MOCK_LOG:?}"
case "$*" in
    *"dev wifi list"*)
        # nmcli -t escapes ':' in values as '\:'
        printf 'HomeNet:82:WPA2:*\nCafe\\:Guest:55::\nNeighbor:30:WPA2:\nHomeNet:40:WPA2:\n' ;;
    *"802-11-wireless-security.psk"*) echo "hunter22" ;;
    *"-f ACTIVE,SSID dev wifi"*) printf 'yes:HomeNet\nno:Neighbor\n' ;;
    *"connection show"*) printf 'HomeNet:802-11-wireless\nWired:802-3-ethernet\n' ;;
esac
exit 0
