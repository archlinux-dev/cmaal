#!/usr/bin/env bash
printf "systemctl %s\n" "$*" >>"${MOCK_LOG:?}"
case "$*" in
    *"is-active --quiet "*)
        unit=${*: -1}
        [[ " ${MOCK_ACTIVE:-} " == *" $unit "* ]]; exit ;;
    *list-unit-files*) printf 'sshd.service disabled -\nbluetooth.service enabled enabled\n' ;;
    *is-active*) echo active ;;
    *is-enabled*) echo enabled ;;
esac
exit 0
