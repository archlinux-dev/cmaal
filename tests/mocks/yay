#!/usr/bin/env bash
F=${MOCK_FIXTURES:?}
printf 'yay %s\n' "$*" >>"${MOCK_LOG:?}"
# options yay 12 no longer knows (it stops with "invalid option")
for a in "$@"; do
    case $a in --nocleanmenu|--nodiffmenu|--noeditmenu|--noupgrademenu|--cleanmenu|--diffmenu|--editmenu|--upgrademenu)
        echo " -> Invalid option '${a#--}'" >&2; exit 1 ;;
    esac
done
[[ -n ${MOCK_YAY_FAIL:-} && $1 == -Syu* ]] && { echo 'error: failed to synchronize all databases' >&2; exit 1; }
names=(); for a in "$@"; do [[ $a == -* ]] || names+=("$a"); done
case $1 in
    -Ss) grep -i -- "${names[0]}" "$F/aur.txt" | awk '{ printf "aur/%s %s\n    an AUR package\n", $1, $2 }' ;;
    -Si) grep -q "^${names[0]} " "$F/aur.txt" || exit 1; printf 'Name : %s\n' "${names[0]}" ;;
    -Qua) printf 'yay-bin 12.3.5-1 -> 12.4.0-1\n' ;;
    --version) echo "yay v12.3.5" ;;
esac
exit 0
