# Maintainer: archlinux-dev <https://github.com/archlinux-dev>
#
# AUR package for cmaal. Install with: yay -S cmaal-git
# Publish / refresh it with packaging/aur/publish.sh

pkgname=cmaal-git
_pkgname=cmaal
pkgver=1.0.0.r0.g0000000
pkgrel=1
pkgdesc="A multitool for Arch Linux: one command for pacman, the AUR and flatpak, plus SSH, rollbacks and system care"
arch=('any')
url="https://github.com/archlinux-dev/cmaal"
license=('Apache-2.0')
depends=('bash' 'pacman' 'curl' 'coreutils' 'findutils' 'gawk' 'grep' 'sed' 'gzip' 'procps-ng')
makedepends=('git' 'make')
optdepends=(
    'fzf: package, service, version and ssh pickers'
    'yay: AUR support (or paru / pikaur)'
    'paru: AUR support'
    'flatpak: search, install and upgrade flatpaks'
    'pacman-contrib: cmaal updates, cache cleaning, dependency chains in cmaal why'
    'reflector: cmaal mirrors'
    'openssh: cmaal ssh'
    'kitty: kitten ssh, new ssh tabs and cmaal theme'
    'snapper: snapshots before upgrades'
    'timeshift: snapshots before upgrades'
    'libnotify: notification when a long upgrade finishes'
    'iproute2: cmaal ports and cmaal ip'
    'jq: AUR search and previews without an AUR helper'
    'bat: syntax highlighting in cmaal pkgbuild'
    'networkmanager: cmaal wifi'
    'bluez-utils: cmaal bluetooth'
    'qrencode: QR code in cmaal wifi share'
    'pciutils: hardware detection in cmaal drivers, gaming and fetch'
    'arch-install-scripts: arch-chroot for cmaal rescue'
    'git: cmaal backup'
)
provides=('cmaal')
conflicts=('cmaal')
source=("$_pkgname::git+https://github.com/archlinux-dev/cmaal.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf '%s.r%s.g%s' "$(tr -d '[:space:]' < VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
    cd "$_pkgname"
    make check
}

package() {
    cd "$_pkgname"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
