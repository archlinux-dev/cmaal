pkgbase = cmaal-git
	pkgdesc = A multitool for Arch Linux: one command for pacman, the AUR and flatpak, plus SSH, rollbacks and system care
	pkgver = 1.0.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/archlinux-dev/cmaal
	arch = any
	license = Apache-2.0
	makedepends = git
	makedepends = make
	depends = bash
	depends = pacman
	depends = curl
	depends = coreutils
	depends = findutils
	depends = gawk
	depends = grep
	depends = sed
	depends = gzip
	depends = procps-ng
	optdepends = fzf: package, service, version and ssh pickers
	optdepends = yay: AUR support (or paru / pikaur)
	optdepends = paru: AUR support
	optdepends = flatpak: search, install and upgrade flatpaks
	optdepends = pacman-contrib: cmaal updates, cache cleaning, dependency chains in cmaal why
	optdepends = reflector: cmaal mirrors
	optdepends = openssh: cmaal ssh
	optdepends = kitty: kitten ssh, new ssh tabs and cmaal theme
	optdepends = snapper: snapshots before upgrades
	optdepends = timeshift: snapshots before upgrades
	optdepends = libnotify: notification when a long upgrade finishes
	optdepends = iproute2: cmaal ports and cmaal ip
	optdepends = jq: AUR search and previews without an AUR helper
	optdepends = bat: syntax highlighting in cmaal pkgbuild
	optdepends = networkmanager: cmaal wifi
	optdepends = bluez-utils: cmaal bluetooth
	optdepends = qrencode: QR code in cmaal wifi share
	optdepends = pciutils: hardware detection in cmaal drivers, gaming and fetch
	optdepends = arch-install-scripts: arch-chroot for cmaal rescue
	optdepends = git: cmaal backup
	provides = cmaal
	conflicts = cmaal
	source = cmaal::git+https://github.com/archlinux-dev/cmaal.git
	sha256sums = SKIP

pkgname = cmaal-git
